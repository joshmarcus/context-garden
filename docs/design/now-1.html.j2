<script>
// The live clock (docs/design/now-1.md, "Live clocks"). This block is the one the build lifts
// into base.html: it ticks every element with data-started (a Now strip, a Board card, the task
// page's run line) from the run's start time and the page's own clock, offset once against the
// server's (data-server-now on <body>), so the figure matches the run page. Nothing here needs
// the events stream; the stream only adds, ends or replaces an element.
(function () {
  var serverNow = Date.parse(document.body.dataset.serverNow || "");
  var offset = isNaN(serverNow) ? 0 : serverNow - Date.now();
  function fmt(s) {
    s = Math.max(0, Math.floor(s));
    var two = function (n) { return (n < 10 ? "0" : "") + n; };
    if (s < 60) return s + " s";
    if (s < 3600) return Math.floor(s / 60) + ":" + two(s % 60);
    return Math.floor(s / 3600) + ":" + two(Math.floor(s % 3600 / 60)) + ":" + two(s % 60);
  }
  function tick() {
    var now = Date.now() + offset;
    document.querySelectorAll("[data-started]:not([data-stopped])").forEach(function (el) {
      var started = Date.parse(el.dataset.started);
      if (isNaN(started)) return;
      var s = (now - started) / 1000;
      var digits = el.querySelector("[data-elapsed]");
      if (digits) digits.textContent = fmt(s);
      var typical = parseFloat(el.dataset.typical);
      if (!(typical > 0)) return;
      var r = s / typical;
      var scale = el.querySelector(".scale");
      if (scale) {
        scale.style.setProperty("--r", Math.min(r, 1).toFixed(3));
        scale.style.setProperty("--o", Math.min(Math.max(r - 1, 0), 0.5).toFixed(3));
      }
      var longer = el.querySelector("[data-longer]");
      if (longer) longer.hidden = r <= 1;
    });
  }
  tick();
  setInterval(tick, 1000);
  window.gardenClock = { fmt: fmt, now: function () { return Date.now() + offset; } };
})();
// Mock-only controls: the theme and gallery toggles, the window switch, the countdown and a
// button that lets a run arrive so the slide-in and the count from zero can be seen.
(function () {
  var q = new URLSearchParams(location.search);
  if (q.get("theme")) document.documentElement.dataset.theme = q.get("theme");
  if (q.get("gallery") === "1") document.getElementById("gallery").hidden = false;
  var themeBtn = document.querySelector("[data-theme-toggle]");
  themeBtn.addEventListener("click", function () {
    var root = document.documentElement;
    var dark = root.dataset.theme === "dark" || (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    root.dataset.theme = dark ? "light" : "dark";
  });
  document.querySelector("[data-gallery-toggle]").addEventListener("click", function () {
    var gal = document.getElementById("gallery"); gal.hidden = !gal.hidden; if (!gal.hidden) gal.scrollIntoView();
  });
  var initial = q.get("window") || "hour";
  function show(key) {
    document.querySelectorAll("[data-window-panel]").forEach(function (el) { el.hidden = el.dataset.windowPanel !== key; });
    document.querySelectorAll("[data-window]").forEach(function (a) { a.classList.toggle("on", a.dataset.window === key); });
  }
  show(initial);
  document.querySelectorAll("[data-window]").forEach(function (a) {
    a.addEventListener("click", function (e) { e.preventDefault(); show(a.dataset.window); });
  });
  var left = {{ g.tick_interval }};
  setInterval(function () {
    left = left > 0 ? left - 1 : {{ g.tick_interval }};
    document.querySelectorAll("[data-countdown]").forEach(function (el) { el.textContent = left; });
  }, 1000);
  // A run arrives: the template strip is cloned with its start time set to now, inserted at the
  // top of Now at no height, and grows in; the clock picks it up on its next tick and counts
  // from zero. The build does the same on a `dispatch` event.
  document.querySelector("[data-arrive]").addEventListener("click", function () {
    var strip = document.getElementById("arrival").content.firstElementChild.cloneNode(true);
    strip.dataset.started = new Date(window.gardenClock.now()).toISOString();
    strip.classList.add("arriving", "new");
    var region = document.getElementById("now");
    region.insertBefore(strip, region.querySelector(".region-head").nextSibling);
    requestAnimationFrame(function () { requestAnimationFrame(function () {
      strip.classList.add("arrive"); strip.classList.remove("arriving");
      setTimeout(function () { strip.classList.remove("new"); }, 3000);
    }); });
  });
})();
</script>
</body>
</html>
