  <div class="g"><h4>a run record without a process (a slot held until a tick reaps it)</h4>{{ strip(dict(base, mode="revise", harness="", model="", no_process=true, elapsed_s=3213, typical_s=360, started_at="2026-09-06T01:01:02")) }}</div>
  <div class="g"><h4>needs you</h4>{{ strip({"kind": "needs_you", "state": "needs_you", "task": "CG-215", "title": "Onboarding skill and command", "reason": "Should the fixture be a Go project or a Node project? The spec names neither.", "glyph": "waiting_human", "dot": "waiting_human"}) }}</div>
