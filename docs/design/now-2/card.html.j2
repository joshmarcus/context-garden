{% macro card(run) -%}
<article class="run {{ run.state }}{{ ' process-missing' if run.no_process|default(false) else '' }}" data-run-id="{{ run.run_id }}" data-started-at="{{ run.started_at }}" data-finished-at="{{ run.finished_at }}" data-typical-seconds="{{ run.typical }}" data-typical-n="{{ run.typical_n|default('') }}">
  <div class="run-heading">{% if run.no_process|default(false) %}<span aria-hidden="true">?</span><span class="mode">Process missing · {{ run.mode }}</span>{% else %}{{ stage(run.state) }}<span class="mode">{{ run.mode }}</span>{% endif %}</div>
  {% if run.no_process|default(false) %}<p class="metadata">Process not found · run record still running</p>{% endif %}
  <h3>{% if run.task_url|default('') %}<a href="{{ run.task_url }}">{{ run.title }}</a>{% else %}{{ run.title }}{% endif %}</h3>
  <p class="metadata">{{ run.harness }} · {{ run.model }} · {{ run.tier }}</p>
  <details class="transcript"><summary>{{ run.line }}</summary><p>{{ run.line }}</p></details>
  {% if run.no_process|default(false) %}<p class="metadata">Elapsed since start · activity unconfirmed</p>{% endif %}
  <div class="timing"><time class="elapsed">{{ run.elapsed }}</time><span class="duration-track" aria-hidden="true"><i></i></span><span class="typical-label">{{ 'typical duration from export · sample n not supplied' if run.typical else ('duration recorded' if run.finished_at else 'Typical not established') }}</span></div>
  <p class="metadata spend">{{ run.cost }}</p>
{% if run.run_url|default('') %}<p class="metadata recovery"><a href="{{ run.run_url }}">Open run</a>{% if run.no_process %} · Reconciliation timing unknown; inspect the run for its latest status.{% endif %}</p>{% endif %}
</article>
{%- endmacro %}
