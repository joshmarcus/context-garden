<div data-window="{{ window.key }}">
<p class="metadata">{{ window.label }} · {{ window.data.since }} → {{ snapshot.captured_at }}</p>
<p class="outcomes"><strong>{{ window.data.merged }} merged</strong> · {% if window.data.first_pass.reviewed %}{{ '%.0f' % (100 * window.data.first_pass.approved / window.data.first_pass.reviewed) }}% first-pass approval{% else %}first-pass approval not recorded{% endif %}<br><strong>${{ '%.2f' % window.data.cost }}</strong> recorded · ${{ '%.2f' % window.data.per_accepted }} / accepted task</p>
<p class="metadata">First-pass n={{ window.data.first_pass.reviewed }} · {{ window.data.runs }} completed runs<br>Unknown-price coverage not supplied.</p>
<div role="img" aria-label="Run completions by exported time bucket: {{ window.data.throughput|join(', ') }}" style="margin:18px 0;color:var(--accent);--viz-1:var(--accent)">{{ window.spark }}</div>
<p class="metadata">Run completions by exported {{ window.data.bucket }} bucket: {{ window.data.throughput|join(', ') }}.<br>Accepted-task throughput timestamps not supplied.</p>
{% if window.data.annotations %}<details><summary class="metadata" style="min-height:44px;padding:12px 0">{{ window.data.annotations|length }} recorded configuration annotations</summary>{% for annotation in window.data.annotations %}<p class="metadata">{{ annotation.at }} · {{ annotation.kind }} · {{ annotation.changed|default([])|join(', ') }}</p>{% endfor %}</details>{% else %}<p class="metadata">No configuration annotations in this export window.</p>{% endif %}
<p class="legend mobile-hint">Scroll to compare models →</p>
{% for metric in window.matrices %}<div class="metric" data-metric="{{ metric.key }}"><div class="table-scroll" tabindex="0" role="region" aria-label="{{ window.label }}: {{ metric.title }} by difficulty and model"><table><caption>{{ metric.title }}<small>{{ metric.direction }} is better · n = {{ metric.denominator }} · exported measurements</small></caption><thead><tr><th scope="col">Difficulty</th>{% for model in window.models %}<th scope="col">{{ model }}</th>{% endfor %}</tr></thead><tbody>
{% for row in metric.rows %}<tr><th scope="row">{{ row.difficulty }}</th>{% for cell in row.cells %}<td class="{{ cell.rank }}{{ ' low' if cell.n > 0 and cell.n < 3 else '' }}" style="--heat-end:var({{ '--best' if cell.shade >= 50 else '--worst' }});--heat-strength:{{ ((cell.shade - 50)|abs) * 2 }}%">{{ cell.display }}<span class="cell-mark" aria-label="{{ cell.rank ~ ' in row' if cell.rank in ['best','worst'] else cell.rank }}">{{ {'best':'↑','worst':'↓','equal':'=','between':'','missing':''}[cell.rank] }}</span><small>n={{ cell.n }}{% if cell.n > 0 and cell.n < 3 %} <span aria-label="provisional, fewer than three observations">†</span>{% endif %}</small></td>{% endfor %}</tr>{% endfor %}
</tbody></table></div></div>{% endfor %}
<p class="legend">↑ best · ↓ worst · = tied or only value · † n &lt; 3, provisional<br>Grounds compare within a row. Colour is never the only signal.</p><p class="metadata">A task using several models appears in each. Columns do not add up. Exported cohorts are preserved; the build’s shared computation contract is in the design document.</p>
<div class="breakdown"><div><h3>Recorded spend by activity</h3><dl>{% for activity, entry in window.data.series.totals.items() %}<div><dt>{{ activity }}</dt><dd>${{ '%.2f' % entry.cost_usd }}</dd></div><div class="bar" style="width:{{ (entry.share or 0) * 100 }}%" aria-hidden="true"></div>{% endfor %}</dl></div><div><h3>Runs and hand steps</h3><dl>{% for entry in window.data.by_model %}<div><dt>{{ entry.who }}</dt><dd>{{ entry.runs }} runs</dd></div>{% endfor %}<div><dt>Hand steps</dt><dd>{{ window.data.hand_steps }} recorded</dd></div><div><dt>Manual merges</dt><dd>not supplied</dd></div></dl><details><summary class="metadata">Recorded hand-step kinds</summary><dl>{% for kind, n in window.data.hand_kinds.items() %}<div><dt>{{ kind }}</dt><dd>{{ n }}</dd></div>{% endfor %}</dl></details></div></div>
</div>
