{
  "head": "202b9b2003252efa805c96f1c9ca1f76293117fc",
  "environment": "disposable local garden fixture served at 127.0.0.1:8876",
  "command": "python scripts/capture_cg410.py",
  "states": [
    "ready",
    "full automated capacity",
    "claimed",
    "stale take",
    "completion failure",
    "completion recovery"
  ],
  "events": [
    {
      "state": "ready with full automated capacity",
      "method": "GET",
      "url": "/inbox",
      "status": 200,
      "consequence": "manual claim is actionable while dependent manual work waits"
    },
    {
      "state": "take",
      "method": "POST",
      "url": "/tasks/DM-001/take",
      "status": 200,
      "consequence": "one manual work run owns the packet"
    },
    {
      "state": "claimed",
      "method": "GET",
      "url": "/tasks/DM-001/packet",
      "status": 200,
      "consequence": "assigned immutable packet is available"
    },
    {
      "state": "stale take",
      "method": "POST",
      "url": "/tasks/DM-001/take",
      "status": 200,
      "consequence": "second request is refused; no duplicate run"
    },
    {
      "state": "completion failure",
      "method": "POST",
      "url": "/tasks/DM-001/finish-manual",
      "status": 200,
      "consequence": "invalid completion leaves the claimed session recoverable"
    },
    {
      "state": "completion recovery",
      "method": "POST",
      "url": "/tasks/DM-001/finish-manual",
      "status": 200,
      "consequence": "valid result finalizes the assigned run"
    }
  ],
  "artifacts": [
    "docs/design/captures/cg-410-manual-inbox-1280-dark.png",
    "docs/design/captures/cg-410-manual-inbox-1280-light.png",
    "docs/design/captures/cg-410-manual-inbox-390-dark.png",
    "docs/design/captures/cg-410-manual-inbox-390-light.png",
    "docs/design/captures/cg-410-manual-task-1280-dark.png",
    "docs/design/captures/cg-410-manual-task-1280-light.png",
    "docs/design/captures/cg-410-manual-task-390-dark.png",
    "docs/design/captures/cg-410-manual-task-390-light.png"
  ],
  "render": [
    {
      "page": "inbox",
      "action": "navigate",
      "viewport": 1280,
      "color_scheme": "light",
      "clientWidth": 1280,
      "scrollWidth": 1280
    },
    {
